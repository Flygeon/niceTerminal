{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "niceTerminal",
  "version": "0.1.0",
  "identifier": "com.niceterminal.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "niceTerminal",
        "width": 1100,
        "height": 720,
        "minWidth": 480,
        "minHeight": 300,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "backgroundColor": "#141218"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "shortDescription": "A fast, beautiful Windows terminal",
    "longDescription": "niceTerminal — a third-party Windows terminal built with Tauri and xterm.js. Material Design 3 inspired theming, multi-tab sessions, event-streamed PTY output.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
